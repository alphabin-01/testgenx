    body: {
      lang: 'javascript',
      code: 'async () => {\n' +
        '  const uniqe = Math.floor(new Date().getTime() / 1000.0);\n' +
        '  const email = `kriti.test+${uniqe}@gmail.com`;\n' +
        '  const password = `Kriti@#$123`;\n' +
        '  // Setup and Initial Navigation\n' +
        '  const page1 = await context.newPage();\n' +
        "  await page1.goto('http://demo.alphabin.co');\n" +
        '  await abPlaywright.setupLogging(page1);\n' +
        '  console.log("kriti");\n' +
        '\n' +
        '  // User Registration Steps\n' +
        "  await page1.locator(locators['SVG Path inside SVG'], {\n" +
        "    description: descriptions['SVG Path inside SVG']\n" +
        '  }).click({\n' +
        '    force: true\n' +
        '  });\n' +
        "  await page1.locator(locators['Span with Text Sign up'], {\n" +
        "    description: descriptions['Span with Text Sign up']\n" +
        '  }).click({\n' +
        '    force: true\n' +
        '  });\n' +
        "  await page1.locator(locators['Input with name firstname'], {\n" +
        "    description: descriptions['Input with name firstname']\n" +
        '  }).click({\n' +
        '    force: true\n' +
        '  });\n' +
        "  await page1.locator(locators['Input with name firstname'], {\n" +
        "    description: descriptions['Input with name firstname']\n" +
        '  }).fill(`Kriti`);\n' +
        "  await page1.locator(locators['Input with name lastname'], {\n" +
        "    description: descriptions['Input with name lastname']\n" +
        '  }).click({\n' +
        '    force: true\n' +
        '  });\n' +
        "  await page1.locator(locators['Input with name lastname'], {\n" +
        "    description: descriptions['Input with name lastname']\n" +
        '  }).fill(`Verma`);\n' +
        "  await page1.locator(locators['Input with name email'], {\n" +
        "    description: descriptions['Input with name email']\n" +
        '  }).click({\n' +
        '    force: true\n' +
        '  });\n' +
        "  await page1.locator(locators['Input with name email'], {\n" +
        "    description: descriptions['Input with name email']\n" +
        '  }).fill(email);\n' +
        "  await page1.locator(locators['Input with name password'], {\n" +
        "    description: descriptions['Input with name password']\n" +
        '  }).click({\n' +
        '    force: true\n' +
        '  });\n' +
        "  await page1.locator(locators['Input with name password'], {\n" +
        "    description: descriptions['Input with name password']\n" +
        '  }).fill(password);\n' +
        "  await page1.locator(locators['Button with Text Create Account'], {\n" +
        "    description: descriptions['Button with Text Create Account']\n" +
        '  }).click({\n' +
        '    force: true\n' +
        '  });\n' +
        '\n' +
        '  // Verification of Registration Success\n' +
        '  await page1.waitForTimeout(1000);\n' +
        "  await expect(page1.locator(locators['Html inside body'], {\n" +
        "    description: descriptions['Html inside body']\n" +
        '  })).toBeVisible();\n' +
        '\n' +
        '  // User Login Steps\n' +
        "  await page1.locator(locators['Input with name email'], {\n" +
        "    description: descriptions['Input with name email']\n" +
        '  }).click({\n' +
        '    force: true\n' +
        '  });\n' +
        "  await page1.locator(locators['Input with name email'], {\n" +
        "    description: descriptions['Input with name email']\n" +
        '  }).fill(email);\n' +
        "  await page1.locator(locators['Div starting with Text Password'], {\n" +
        "    description: descriptions['Div starting with Text Password']\n" +
        '  }).click({\n' +
        '    force: true\n' +
        '  });\n' +
        "  await page1.locator(locators['Input with name password'], {\n" +
        "    description: descriptions['Input with name password']\n" +
        '  }).click({\n' +
        '    force: true\n' +
        '  });\n' +
        "  await page1.locator(locators['Input with name password'], {\n" +
        "    description: descriptions['Input with name password']\n" +
        '  }).fill(password);\n' +
        "  await page1.locator(locators['Input with name password'], {\n" +
        "    description: descriptions['Input with name password']\n" +
        '  }).press(`Enter`);\n' +
        '\n' +
        '  // Verification of Login Success\n' +
        "  await expect(page1.locator(locators['Html'], {\n" +
        "    description: descriptions['Html']\n" +
        '  })).toBeVisible();\n' +
        '\n' +
        '  // Post-Login Actions\n' +
        '  await page1.mouse.wheel(1, 1621);\n' +
        '  await page1.mouse.wheel(1, 901);\n' +
        '\n' +
        '  // Cleanup\n' +
        '  await page1.close();\n' +
        '}'
